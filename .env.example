# ============================================================
# Copie este arquivo para .env.local e preencha.
# Nada aqui vai pro Git (o .gitignore ja cuida disso).
# ============================================================

# ---------- Supabase (banco de dados + login + fotos) ----------
# Painel do Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://SEUPROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service_role). SO no servidor — nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Conexao direta com o banco, usada por "npm run migrate".
# Painel do Supabase > Connect > ORMs (use a "Session pooler").
DATABASE_URL=

# ---------- Google Maps ----------
# console.cloud.google.com > APIs e Servicos > Credenciais
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Opcional: id de um estilo de mapa proprio. Sem isso usa o padrao.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ---------- Chat com a Claude ----------
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# Opcional: troque o modelo sem mexer no codigo.
# claude-opus-5 (padrao, melhor) | claude-sonnet-5 | claude-haiku-4-5
CHAT_MODELO=

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://oquefazeremivoti.com.br
